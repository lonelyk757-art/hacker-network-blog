{
  "version": 2,
  "buildCommand": "echo 'Static site'",
  "outputDirectory": "public",
  "env": [
    "DATABASE_URL",
    "JWT_SECRET",
    "ADMIN_PASSWORD_HASH",
    "STORAGE_API_KEY",
    "STORAGE_BUCKET"
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
